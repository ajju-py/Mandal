# Supabase Configuration for धर्मवीर संभाजी क्रीडा मंडळ CMS
# Obtain these from your Supabase Project Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Service Role Key for running the initial data migration/seed script (Never expose in browser!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
